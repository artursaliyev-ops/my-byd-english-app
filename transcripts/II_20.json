   "start": 1480.6,
   "end": 1483.06,
   "text": "No wait, that's the right street",
   "lang": "en"
  },
  {
   "start": 1487.88,
   "end": 1489.5,
   "text": "Но номер не тот.",
   "lang": "ru"
  },
