   "text": "In the afternoon",
   "lang": "ru"
  },
  {
   "start": 1468.42,
   "end": 1470.72,
   "text": "At 3 o'clock in the afternoon.",
   "lang": "en"
  },
  {
   "start": 1476.08,
   "end": 1479.54,
   "text": "Я знаю, а в следующее воскресенье?",
   "lang": "ru"
  },
  {
   "start": 1483.88,
   "end": 1486.26,
   "text": "I know, and next Sunday?",
   "lang": "ru"
  },
  {
   "start": 1486.26,
   "end": 1486.4,
   "text": "Okay.",
   "lang": "en"
  },
  {
   "start": 1491.56,
   "end": 1492.66,
   "text": "Один наш коллега",
   "lang": "ru"
  },
  {
