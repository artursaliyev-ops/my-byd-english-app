   "text": "А другая в три часа",
   "lang": "ru"
  },
  {
   "start": 1453.94,
   "end": 1455.92,
   "text": "And another one at three o'clock",
   "lang": "ru"
  },
  {
   "start": 1460.1,
   "end": 1461.72,
   "text": "Во второй половине дня",
   "lang": "ru"
  },
  {
