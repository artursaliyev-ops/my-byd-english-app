   "text": "Я могу также купить для вас газету. Используйте полную форму.",
   "lang": "ru"
  },
  {
   "start": 1411.88,
   "end": 1414.06,
   "text": "I can buy a newspaper for you too.",
   "lang": "en"
  },
  {
   "start": 1417.28,
   "end": 1423.06,
   "text": "У нас сегодня много встреч.",
   "lang": "ru"
  },
  {
   "start": 1427.14,
   "end": 1429.38,
   "text": "We have a lot of meetings today.",
   "lang": "en"
  },
  {
   "start": 1433.3,
   "end": 1435.38,
   "text": "Одна сегодня утром.",
   "lang": "ru"
  },
  {
   "start": 1438.58,
   "end": 1440.14,
   "text": "We have one this morning",
   "lang": "en"
  },
  {
   "start": 1443.04,
