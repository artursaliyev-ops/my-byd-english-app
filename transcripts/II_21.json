  },
  {
   "start": 1180.26,
   "end": 1182.0,
   "text": "We arrived last night.",
   "lang": "en"
  },
  {
   "start": 1185.66,
   "end": 1188.24,
   "text": "Но мы мало что видели.",
   "lang": "ru"
  },
  {
   "start": 1191.82,
   "end": 1194.62,
   "text": "Но мы не видели очень много.",
   "lang": "ru"
  },
  {
   "start": 1198.46,
   "end": 1200.54,
   "text": "Мы не видели очень много.",
   "lang": "ru"
  },
  {
   "start": 1204.76,
   "end": 1207.0,
   "text": "Потому что сегодня праздник.",
   "lang": "ru"
  },
  {
   "start": 1210.26,
   "end": 1212.1,
   "text": "Потому что сегодня праздник.",
