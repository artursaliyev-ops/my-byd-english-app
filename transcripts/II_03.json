   "lang": "en"
  },
  {
   "start": 1540.22,
   "end": 1542.82,
   "text": "Пробуйте ответить, что вы делали сегодня?",
   "lang": "ru"
  },
  {
   "start": 1542.82,
   "end": 1546.0,
   "text": "Сегодня утром я виделась с несколькими друзьями.",
   "lang": "ru"
  },
  {
   "start": 1550.82,
   "end": 1553.22,
   "text": "This morning I saw some friends",
   "lang": "en"
  },
  {
   "start": 1557.74,
   "end": 1559.26,
   "text": "I saw",
   "lang": "en"
  },
  {
   "start": 1560.14,
   "end": 1563.68,
   "text": "и сходила в универмаг.",
   "lang": "ru"
  },
  {
   "start": 1568.7,
   "end": 1570.6,
   "text": "And I went to a department store.",
   "lang": "en"
  },
  {
   "start": 1575.1,
   "end": 1576.72,
   "text": "С мужем?",
   "lang": "ru"
  },
  {
   "start": 1579.26,
   "end": 1580.24,
   "text": "With your husband?",
   "lang": "en"
  },
  {
   "start": 1583.4,
   "end": 1585.68,
   "text": "Скажите, что нет, вы ходили одна.",
   "lang": "ru"
  },
  {
   "start": 1590.5,
   "end": 1591.96,
   "text": "No, I went alone.",
   "lang": "en"
  },
  {
   "start": 1595.48,
   "end": 1597.0,
   "text": "Что купили?",
   "lang": "ru"
  },
  {
   "start": 1599.96,
   "end": 1601.4,
   "text": "Что вы купили?",
   "lang": "ru"
  },
  {
   "start": 1601.4,
   "end": 1601.5,
   "text": "Bye.",
   "lang": "en"
  },
  {
   "start": 1604.78,
   "end": 1607.58,
   "text": "Ответьте, что купили слишком много вещей.",
   "lang": "ru"
  },
  {
   "start": 1612.18,
   "end": 1614.22,
   "text": "I bought too many things.",
   "lang": "ru"
  },
  {
   "start": 1618.44,
   "end": 1619.94,
   "text": "Потом мы поели.",
   "lang": "ru"
  },
  {
   "start": 1623.04,
   "end": 1624.36,
   "text": "Then we ate.",
   "lang": "ru"
  },
  {
   "start": 1627.08,
   "end": 1629.82,
   "text": "В очень хорошем ресторане.",
   "lang": "ru"
  },
  {
   "start": 1634.04,
   "end": 1635.94,
   "text": "At a very good restaurant",
   "lang": "en"
  },
  {
   "start": 1646.28,
   "end": 1649.36,
   "text": "Мы говорили по-английски с официантом.",
   "lang": "ru"
  },
  {
   "start": 1653.56,
   "end": 1655.4,
   "text": "We spoke English with the waiter.",
   "lang": "en"
  },
  {
   "start": 1659.46,
   "end": 1662.7,
   "text": "Сейчас я собираюсь купить немного вина.",
   "lang": "ru"
  },
  {
   "start": 1667.5,
   "end": 1669.46,
   "text": "Now I'm going to buy some wine.",
   "lang": "en"
  },
  {
   "start": 1673.8,
   "end": 1676.54,
   "text": "И немного мексиканского пива.",
   "lang": "ru"
  },
  {
   "start": 1680.32,
   "end": 1682.08,
   "text": "and some Mexican beer.",
   "lang": "en"
  },
  {
   "start": 1684.5,
   "end": 1688.7,
   "text": "Вам нравится мексиканское пиво, да?",
   "lang": "ru"
  },
  {
   "start": 1693.88,
   "end": 1696.24,
   "text": "You like Mexican beer, don't you?",
   "lang": "ru"
  },
  {
   "start": 1701.42,
   "end": 1702.1,
   "text": "Don't you?",
   "lang": "ru"
  },
  {
   "start": 1704.68,
   "end": 1708.2,
   "text": "Теперь спросите своего знакомого, куда он ходил сегодня.",
   "lang": "ru"
  },
  {
   "start": 1712.52,
   "end": 1713.96,
   "text": "Where did you go today?",
   "lang": "ru"
  },
  {
   "start": 1713.96,
   "end": 1714.16,
   "text": "day.",
   "lang": "en"
  },
  {
   "start": 1717.62,
   "end": 1718.58,
   "text": "Where did you go?",
   "lang": "ru"
  },
  {
   "start": 1721.58,
   "end": 1722.86,
   "text": "Where did you go today?",
   "lang": "en"
  },
  {
   "start": 1725.94,
   "end": 1728.42,
   "text": "Я ездил в Бостон.",
   "lang": "ru"
  },
  {
   "start": 1731.84,
   "end": 1733.2,
   "text": "I went to Boston.",
   "lang": "en"
  },
  {
   "start": 1736.1,
   "end": 1739.76,
   "text": "Я встретился там с несколькими знакомыми.",
   "lang": "ru"
  },
  {
   "start": 1743.54,
   "end": 1745.62,
   "text": "I saw a few friends there.",
   "lang": "en"
  },
  {
   "start": 1748.1,
   "end": 1751.54,
   "text": "Вы знаете Бостон?",
   "lang": "ru"
  },
  {
   "start": 1754.72,
   "end": 1755.96,
   "text": "Do you know Boston?",
   "lang": "en"
  },
  {
   "start": 1758.88,
   "end": 1761.74,
   "text": "Кратко ответьте «нет».",
   "lang": "ru"
  },
  {
   "start": 1764.86,
   "end": 1766.02,
   "text": "No, I don't.",
   "lang": "en"
  },
  {
   "start": 1768.64,
   "end": 1769.48,
   "text": "He says,",
   "lang": "en"
  },
  {
   "start": 1769.76,
   "end": 1771.58,
   "text": "Это небольшой город.",
   "lang": "ru"
  },
  {
   "start": 1775.44,
   "end": 1776.8,
   "text": "It's not a big city.",
   "lang": "en"
  },
  {
   "start": 1780.74,
   "end": 1781.28,
   "text": "Say it.",
   "lang": "en"
  },
  {
   "start": 1781.3,
   "end": 1784.14,
   "text": "Мне бы хотелось съездить в Бостон.",
   "lang": "ru"
  },
  {
   "start": 1788.32,
   "end": 1789.64,
   "text": "I'd like to go to Boston.",
   "lang": "en"
  },
  {
   "start": 1793.5,
   "end": 1795.6,
   "text": "Но у меня много работы.",
   "lang": "ru"
  },
  {
   "start": 1799.74,
   "end": 1801.34,
   "text": "But I have a lot of work.",
   "lang": "en"
  },
  {
   "start": 1805.22,
   "end": 1808.84,
   "text": "У меня слишком много работы.",
   "lang": "ru"
  },
  {
   "start": 1812.26,
   "end": 1814.96,
   "text": "I have too much work.",
   "lang": "ru"
  },
  {
   "start": 1819.12,
   "end": 1820.54,
   "text": "I have too much work.",
   "lang": "en"
  },
  {
   "start": 1820.7,
   "end": 1821.54,
   "text": "Say",
   "lang": "ru"
  },
  {
   "start": 1824.02,
   "end": 1825.42,
   "text": "Say.",
   "lang": "en"
  },
  {
   "start": 1825.64,
   "end": 1828.3,
   "text": "До свидания. Увидимся завтра.",
   "lang": "ru"
  },
  {
   "start": 1833.04,
   "end": 1835.1,
   "text": "Goodbye. See you tomorrow.",
   "lang": "ru"
  },
  {
   "start": 1839.76,
   "end": 1842.48,
   "text": "Это конец третьего урока.",
   "lang": "ru"
  }
 ]
