  },
  {
   "start": 1739.14,
   "end": 1741.44,
   "text": "Питер Джонсон? Кто он?",
   "lang": "ru"
  },
  {
   "start": 1745.38,
   "end": 1747.42,
   "text": "Peter Johnson, who's that?",
