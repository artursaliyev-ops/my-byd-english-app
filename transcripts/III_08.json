  },
  {
   "start": 1597.44,
   "end": 1599.1,
   "text": "The steak is very good.",
   "lang": "en"
  },
  {
   "start": 1602.18,
   "end": 1604.5,
   "text": "You and your wife both ordered the steak.",
   "lang": "en"
  },
  {
   "start": 1605.26,
   "end": 1609.2,
   "text": "Нам бы также хотелось полбутылки красного вина.",
