  },
  {
   "start": 1507.54,
   "end": 1509.94,
   "text": "под вашей газетой",
   "lang": "ru"
  },
  {
   "start": 1512.36,
   "end": 1513.96,
   "text": "under your newspaper.",
   "lang": "en"
  },
  {
   "start": 1517.06,
   "end": 1517.86,
   "text": "Say,",
   "lang": "en"
  },
  {
   "start": 1518.16,
   "end": 1519.8,
   "text": "Благодарю, а сейчас?",
   "lang": "ru"
  },
  {
   "start": 1519.8,
   "end": 1520.0,
   "text": "Yes.",
   "lang": "en"
  },
  {
   "start": 1523.5,
   "end": 1524.28,
   "text": "Thank you.",
   "lang": "en"
  },
  {
   "start": 1524.34,
   "end": 1525.3,
   "text": "And now...",
   "lang": "en"
  },
  {
   "start": 1528.04,
   "end": 1530.52,
   "text": "Если у вас есть время",
   "lang": "ru"
  },
  {
   "start": 1530.52,
   "end": 1530.66,
   "text": "Amen.",
   "lang": "en"
  },
  {
   "start": 1533.26,
   "end": 1534.24,
   "text": "If you have time.",
   "lang": "en"
  },
  {
   "start": 1536.62,
   "end": 1540.24,
   "text": "Мне бы хотелось обсудить сегодняшнюю встречу",
   "lang": "ru"
  },
  {
   "start": 1540.24,
   "end": 1540.88,
   "text": "Thank you.",
   "lang": "en"
  },
  {
   "start": 1544.4,
   "end": 1546.68,
   "text": "I'd like to discuss today's meeting.",
   "lang": "ru"
  },
  {
   "start": 1551.28,
   "end": 1552.22,
   "text": "Today's meeting.",
   "lang": "ru"
  },
  {
   "start": 1554.28,
   "end": 1557.78,
   "text": "После работы вы встречаетесь с женой в ресторане.",
   "lang": "ru"
  },
  {
   "start": 1558.98,
   "end": 1562.04,
   "text": "Как вам скажет администратор зала, что меню на столике?",
