  },
  {
   "start": 1694.34,
   "end": 1697.18,
   "text": "Yes, I made the reservations this morning.",
   "lang": "ru"
  },
  {
   "start": 1700.18,
   "end": 1700.7,
   "text": "Thank you.",
   "lang": "en"
  },
  {
   "start": 1702.3,
   "end": 1704.5,
   "text": "I made the reservations this morning.",
   "lang": "ru"
  },
  {
   "start": 1709.02,
   "end": 1710.02,
   "text": "Now say,",
   "lang": "ru"
  },
  {
   "start": 1710.2,
   "end": 1713.12,
   "text": "Питер Джонсон живет сейчас в Сан-Франциско.",
