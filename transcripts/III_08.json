  },
  {
   "start": 1718.4,
   "end": 1721.36,
   "text": "Peter Johnson lives in San Francisco now.",
   "lang": "en"
  },
  {
   "start": 1726.16,
   "end": 1729.2,
   "text": "Может быть, мы сможем навестить Питера?",
   "lang": "ru"
  },
  {
   "start": 1732.8,
   "end": 1734.4,
   "text": "Maybe we can visit Peter.",
