   "end": 1384.86,
   "text": "Ask again.",
   "lang": "ru"
  },
  {
   "start": 1385.14,
   "end": 1386.54,
   "text": "Разве ты не помнишь?",
   "lang": "ru"
  },
  {
   "start": 1389.44,
   "end": 1390.64,
   "text": "Don't you remember?",
   "lang": "ru"
  },
  {
   "start": 1393.28,
   "end": 1396.44,
   "text": "Мы останавливались там несколько лет назад.",
   "lang": "ru"
  },
  {
   "start": 1399.84,
   "end": 1401.74,
   "text": "We stayed there a few years ago.",
   "lang": "en"
  },
  {
   "start": 1404.94,
   "end": 1408.42,
   "text": "Чуть позже вы звоните в ХАЕД.",
   "lang": "ru"
  },
  {
   "start": 1409.22,
   "end": 1411.32,
   "text": "Затем вы рассказываете об этом коллеге.",
   "lang": "ru"
  },
  {
   "start": 1412.2,
   "end": 1413.8,
   "text": "Ну, я сделал резервирование.",
   "lang": "ru"
  },
  {
   "start": 1417.96,
   "end": 1419.7,
   "text": "Well, I made the reservations.",
   "lang": "en"
  },
  {
   "start": 1423.94,
   "end": 1425.38,
   "text": "I made the reservations.",
   "lang": "ru"
  },
  {
   "start": 1425.38,
   "end": 1428.98,
   "text": "Thank you for your time and your observations.",
   "lang": "en"
  },
  {
   "start": 1429.04,
   "end": 1430.98,
   "text": "Now ask her if she has a pen.",
   "lang": "ru"
  },
  {
   "start": 1433.88,
   "end": 1435.22,
   "text": "Do you have a pen?",
   "lang": "ru"
  },
  {
   "start": 1438.34,
   "end": 1438.9,
   "text": "Ask.",
   "lang": "ru"
  },
  {
   "start": 1439.68,
   "end": 1441.32,
   "text": "А ты видела мои записи?",
   "lang": "ru"
  },
  {
   "start": 1445.08,
   "end": 1446.8,
   "text": "And have you seen my notes?",
   "lang": "ru"
  },
  {
   "start": 1450.36,
   "end": 1451.48,
   "text": "Сегодня утром.",
   "lang": "ru"
  },
  {
   "start": 1451.48,
   "end": 1454.52,
   "text": "This morning",
   "lang": "en"
  },
  {
   "start": 1455.86,
   "end": 1459.04,
   "text": "Они были на этом столе.",
   "lang": "ru"
  },
  {
   "start": 1462.42,
   "end": 1463.86,
   "text": "They were on this table.",
   "lang": "en"
  },
  {
   "start": 1466.0,
   "end": 1471.0,
   "text": "Она приносит бумаги и спрашивает, это ваши записи?",
   "lang": "ru"
  },
  {
   "start": 1474.0,
   "end": 1475.66,
   "text": "Are these your notes?",
   "lang": "ru"
  },
  {
   "start": 1478.5,
   "end": 1480.0,
   "text": "Are these your notes?",
   "lang": "en"
  },
  {
   "start": 1480.24,
   "end": 1480.88,
   "text": "Say",
   "lang": "ru"
  },
  {
   "start": 1483.84,
   "end": 1485.26,
   "text": "Да, где они были?",
   "lang": "ru"
  },
  {
   "start": 1488.52,
   "end": 1490.12,
   "text": "Yes, where were they?",
   "lang": "ru"
  },
  {
   "start": 1493.32,
   "end": 1495.02,
   "text": "Yes, where were they?",
   "lang": "ru"
  },
  {
   "start": 1498.02,
   "end": 1499.1,
   "text": "She answers",
   "lang": "ru"
  },
  {
   "start": 1499.1,
   "end": 1500.8,
   "text": "Рядом с этой книгой",
   "lang": "ru"
  },
  {
   "start": 1504.28,
   "end": 1505.44,
   "text": "Next to that book.",
