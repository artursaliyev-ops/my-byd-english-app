  },
  {
   "start": 1613.88,
   "end": 1616.46,
   "text": "We'd like a half bottle of red wine too.",
   "lang": "en"
  },
  {
   "start": 1621.46,
   "end": 1622.4,
   "text": "Say to your wife,",
   "lang": "en"
  },
  {
   "start": 1622.42,
   "end": 1625.34,
   "text": "Теперь давай поговорим о нашей поездке.",
   "lang": "ru"
  },
  {
   "start": 1628.38,
   "end": 1630.46,
   "text": "Now let's discuss our trip.",
   "lang": "en"
  },
  {
   "start": 1634.12,
   "end": 1635.86,
   "text": "Let's discuss our trip.",
   "lang": "en"
  },
  {
   "start": 1639.14,
   "end": 1640.16,
   "text": "She says.",
   "lang": "en"
  },
  {
   "start": 1640.56,
   "end": 1642.72,
   "text": "Мы поедем в Сан-Франциско, не так ли?",
