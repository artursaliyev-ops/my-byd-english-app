  },
  {
   "start": 1751.46,
   "end": 1752.32,
   "text": "Who's that?",
   "lang": "en"
  },
  {
   "start": 1754.78,
   "end": 1756.88,
   "text": "Ты не помнишь?",
   "lang": "ru"
  },
  {
   "start": 1759.34,
   "end": 1760.3,
   "text": "Don't you remember?",
   "lang": "en"
  },
  {
   "start": 1763.0,
   "end": 1764.02,
   "text": "Don't you remember?",
   "lang": "en"
  },
  {
   "start": 1766.58,
   "end": 1768.3,
   "text": "Раньше мы работали вместе.",
   "lang": "ru"
  },
  {
   "start": 1771.16,
   "end": 1773.18,
   "text": "We used to work together.",
   "lang": "en"
  },
  {
   "start": 1781.36,
   "end": 1782.4,
   "text": "Несколько лет назад.",
   "lang": "ru"
  },
  {
   "start": 1784.98,
   "end": 1786.28,
   "text": "A few years ago.",
   "lang": "en"
  },
  {
   "start": 1789.12,
   "end": 1791.24,
   "text": "А, да, теперь я вспоминаю.",
