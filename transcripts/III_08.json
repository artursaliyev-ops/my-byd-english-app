  },
  {
   "start": 1661.72,
   "end": 1662.88,
   "text": "Yes we are.",
   "lang": "en"
  },
  {
   "start": 1664.3,
   "end": 1668.2,
   "text": "Ты уже забронировал нам номер в отеле?",
   "lang": "ru"
  },
  {
   "start": 1672.62,
   "end": 1675.0,
   "text": "Have you made our hotel reservations yet?",
   "lang": "en"
  },
  {
   "start": 1679.54,
   "end": 1681.58,
   "text": "Have you made our hotel reservations yet?",
   "lang": "en"
  },
  {
   "start": 1681.6,
   "end": 1689.56,
   "text": "Да, я забронировал сегодня утром.",
