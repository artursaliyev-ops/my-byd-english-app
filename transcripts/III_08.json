  },
  {
   "start": 1798.98,
   "end": 1804.44,
   "text": "После того, как вы закончите, как вы попросите счет?",
   "lang": "ru"
  },
  {
   "start": 1807.38,
   "end": 1808.44,
   "text": "The check, please.",
   "lang": "en"
  },
  {
   "start": 1810.48,
