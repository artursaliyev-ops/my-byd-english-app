  },
  {
   "start": 1582.6,
   "end": 1584.04,
   "text": "Ask him what he recommends.",
   "lang": "en"
  },
  {
   "start": 1587.88,
   "end": 1588.96,
   "text": "What do you recommend?",
   "lang": "en"
  },
  {
   "start": 1592.02,
   "end": 1592.72,
   "text": "He said",
   "lang": "en"
  },
  {
   "start": 1592.86,
   "end": 1594.48,
   "text": "Бифштекс очень хорош.",
